            echo json_encode($dao->crear(leerCategoria()));
            break;

        case "PUT":
            echo json_encode($dao->actualizar($id, leerCategoria()));
            break;

        case "DELETE":
            echo $dao->eliminar($id);
            break;
    }
} catch (PDOException $exception) {
    error_log($exception->getMessage());
}

