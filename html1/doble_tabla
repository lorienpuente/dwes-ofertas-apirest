5. dao/DAOCategoriasMySQL.php (nuevo)

php
<?php

require_once __DIR__ . "/DAOCategorias.php";
require_once __DIR__ . "/../entities/Categoria.php";

class DAOCategoriasMySQL implements DAOCategorias
{
    private PDO $db;

    public function __construct(PDO $db)
    {
        $this->db = $db;
    }

    public function obtenerTodas(): array
    {
        $statement = $this->db->query("SELECT id, nombre FROM categorias ORDER BY id ASC");
        return array_map([$this, "crearCategoriaDesdeFila"], $statement->fetchAll());
    }

    public function obtenerPorId(int $id): ?Categoria
    {
        $statement = $this->db->prepare("SELECT id, nombre FROM categorias WHERE id = :id");
        $statement->execute(["id" => $id]);
        $row = $statement->fetch();

        return $row === false ? null : $this->crearCategoriaDesdeFila($row);
    }

    public function crear(Categoria $categoria): Categoria
    {
        $statement = $this->db->prepare("INSERT INTO categorias (nombre) VALUES (:nombre)");
        $statement->execute(["nombre" => $categoria->nombre]);

        return $this->obtenerPorId((int) $this->db->lastInsertId());
    }

    public function actualizar(int $id, Categoria $categoria): ?Categoria
    {
        $statement = $this->db->prepare("UPDATE categorias SET nombre = :nombre WHERE id = :id");
        $statement->execute([
            "nombre" => $categoria->nombre,
            "id" => $id
        ]);

        return $this->obtenerPorId($id);
    }

    public function eliminar(int $id): bool
    {
        $statement = $this->db->prepare("DELETE FROM categorias WHERE id = :id");
        $statement->execute(["id" => $id]);

        return $statement->rowCount() > 0;
    }

    private function crearCategoriaDesdeFila(array $row): Categoria
    {
        return new Categoria((int) $row["id"], $row["nombre"]);
    }
}

