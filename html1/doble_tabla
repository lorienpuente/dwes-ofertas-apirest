try {
    $dao = DAOFactory::getDAOCategorias();

    switch ($metodo) {
        case "GET":
            if ($id === null) {
                echo json_encode($dao->obtenerTodas());
                break;
            }
            echo json_encode($dao->obtenerPorId($id));
            break;

